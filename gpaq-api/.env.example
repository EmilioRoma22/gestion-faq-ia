# =============================================================================
# Variables de entorno para el servicio API: gestion-faq-ia-api (Railway / Local)
# -----------------------------------------------------------------------------
# En Railway:
#   1. Crea primero el servicio "MySQL" (Database -> Add MySQL).
#   2. Crea el servicio "gestion-faq-ia-api" apuntando al Root Directory: /gpaq-api
#   3. Ve a la pestaña "Variables" -> "Raw Editor" y pega este contenido.
#   4. Las variables con sintaxis ${{MySQL.*}} y ${{gestion-faq-ia-frontend.*}}
#      se enlazan automáticamente con tus servicios en el mismo proyecto de Railway.
# =============================================================================

# --- Entorno y Servidor ------------------------------------------------------
ENV=production
PORT=8000
UVICORN_WORKERS=2
DOCS_ENABLED=false

# --- CORS y Cookies ----------------------------------------------------------
# Toma automáticamente el dominio público de tu servicio "gestion-faq-ia-frontend" en Railway.
# IMPORTANTE: No uses "*" porque allow_credentials está activo.
CORS_ORIGINS=https://${{gestion-faq-ia-frontend.RAILWAY_PUBLIC_DOMAIN}},http://localhost:8080,http://localhost:5173
COOKIES_SECURE=true
COOKIES_SAMESITE=lax

# --- Seguridad JWT -----------------------------------------------------------
# Cadena larga y aleatoria para firmar los tokens JWT de sesión de administrador
JWT_SECRET=gpaq-railway-prod-jwt-secret-key-2026-x9a8b7c6d5e4f3

# --- Integración IA (DeepSeek) -----------------------------------------------
# Coloca tu API Key real de DeepSeek (si dejas el valor de ejemplo, opera en modo simulado)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# --- Base de Datos MySQL (Referencias automáticas al servicio MySQL de Railway) ---
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=10