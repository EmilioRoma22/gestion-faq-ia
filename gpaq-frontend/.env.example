# =============================================================================
# Variables de entorno para el servicio Frontend: gestion-faq-ia-frontend (Railway / Local)
# -----------------------------------------------------------------------------
# En Railway:
#   1. Crea el servicio "gestion-faq-ia-frontend" apuntando al Root Directory: /gpaq-frontend
#   2. Asegúrate de haber generado un dominio público en el servicio "gestion-faq-ia-api"
#      (Settings -> Networking -> Generate Domain).
#   3. Ve a la pestaña "Variables" -> "Raw Editor" de este servicio frontend y pega este contenido.
#   4. La referencia ${{gestion-faq-ia-api.RAILWAY_PUBLIC_DOMAIN}} tomará automáticamente
#      el dominio público de tu servicio API en Railway.
# =============================================================================

# Puerto en el que escucha el contenedor NGINX (Railway inyecta PORT automáticamente)
PORT=8080

# URL pública hacia la API (usada por Vite en build y por NGINX como respaldo)
# Si tu servicio de API en Railway se llama exactamente "gestion-faq-ia-api",
# esta referencia se resuelve automáticamente:
VITE_API_BASE_URL=https://${{gestion-faq-ia-api.RAILWAY_PUBLIC_DOMAIN}}/api/v1

# URL base del backend para el reverse proxy /api/ de NGINX en tiempo de ejecución
API_BACKEND_URL=https://${{gestion-faq-ia-api.RAILWAY_PUBLIC_DOMAIN}}
