# =============================================================================
# Plantilla de variables de entorno para Docker Compose (gestion-faq-ia)
# -----------------------------------------------------------------------------
# Copia este archivo a ".env" y ajusta los valores.
#   Linux/Mac : cp .env.example .env
#   Windows   : Copy-Item .env.example .env
#
# IMPORTANTE: TODAS las variables son OBLIGATORIAS. Si falta cualquiera,
# "docker compose up" fallará inmediatamente indicando cuál falta.
# =============================================================================

# --- Aplicación / API ---------------------------------------------------------
# Entorno de ejecución: development | production
ENV=production
# Habilitar documentación interactiva (/docs, /redoc). true | false
DOCS_ENABLED=false
# Orígenes permitidos para CORS (separados por coma). NO puede ser "*".
# Con el proxy de NGINX el origen del navegador es http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# Cookies seguras (solo HTTPS). true | false
COOKIES_SECURE=false
# Política SameSite de cookies: lax | strict | none
COOKIES_SAMESITE=lax
# Número de workers de Uvicorn (>= 1)
UVICORN_WORKERS=2
# Secreto para firmar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Integración DeepSeek -----------------------------------------------------
# Clave de la API de DeepSeek. Si no tienes una válida, la API funciona en
# modo simulado (mock), pero la variable debe estar presente igualmente.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URL base de la API de DeepSeek
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# --- Conexión de la API a la base de datos ------------------------------------
# Host = nombre del servicio MySQL dentro de la red de Compose
DB_HOST=db
DB_PORT=3306
# La inicialización (db/run_init.py) crea la BD y las tablas, por lo que
# requiere privilegios. Usa el usuario root del contenedor MySQL.
DB_USER=root
# Debe coincidir con MYSQL_ROOT_PASSWORD (más abajo).
DB_PASSWORD=cambia-esta-password-root
DB_NAME=gestion_faq_bd
# Tamaño máximo del pool de conexiones (>= 1)
DB_POOL_SIZE=5
# Timeout (segundos) para establecer la conexión (>= 1)
DB_CONNECTION_TIMEOUT=10

# --- Contenedor MySQL ---------------------------------------------------------
# Contraseña del usuario root de MySQL (debe coincidir con DB_PASSWORD).
MYSQL_ROOT_PASSWORD=cambia-esta-password-root
# Base de datos creada automáticamente al levantar el contenedor.
MYSQL_DATABASE=gestion_faq_bd
# Usuario de aplicación adicional (creado por la imagen de MySQL).
MYSQL_USER=gpaq_user
MYSQL_PASSWORD=cambia-esta-password-usuario

# --- Frontend (build) ---------------------------------------------------------
# Base URL de la API usada por el frontend. Con el proxy de NGINX debe ser
# una ruta relativa; se inyecta en tiempo de build.
VITE_API_BASE_URL=/api/v1
